# TLS-enabled Nginx config (issue #142, docs/09-seguranca-e-privacidade.md
# §9.3: "TLS 1.2+ obrigatório"). Opt-in: used in place of ../app.conf.template
# via docker-compose.tls.yml, once a certificate exists under ./certs/ (see
# scripts/generate_local_node_tls_cert.sh for the local node's self-signed
# certificate + root CA, or docs/11-implantacao-e-operacoes.md for the
# central node's public certificate). See app.conf.template's own header
# comment for the templating mechanism (envsubst at container startup).

upstream fenixschool_app {
    server web:8000;
}

# Plain HTTP only redirects to HTTPS -- never serves the application itself
# once TLS is active.
server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # TLS 1.2+ only, modern forward-secret ciphers (RNF-SEC-01).
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 20M;

    # See app.conf.template for why these two locations bypass Django/gunicorn
    # entirely and their differing cache lifetimes.
    location /static/ {
        alias /app/staticfiles/;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Justification attachments (issue #67, RF-FREQ-02/§9.3: "nunca URL
    # pública directa") -- see app.conf.template's own comment for why this
    # more specific prefix wins over /media/ below regardless of order.
    location /media/attendance/justifications/ {
        deny all;
        return 404;
    }

    location /media/ {
        alias /app/media/;
        add_header Cache-Control "public, max-age=3600";
    }

    location / {
        proxy_pass http://fenixschool_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Lets Django (SECURE_PROXY_SSL_HEADER, config/settings/base.py) know
        # this request arrived over HTTPS, even though this proxy_pass itself
        # talks to `web` over plain HTTP inside the Docker network.
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
