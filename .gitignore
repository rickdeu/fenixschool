# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/

# Django
*.log
# Rotated log backups (logging.handlers.TimedRotatingFileHandler) are named
# fenixschool.log.YYYY-MM-DD, not *.log -- see config/settings/base.py.
logs/
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
# Compiled translation catalogues (issue #150) -- derived from locale/**/*.po,
# generated via `django-admin compilemessages`, not committed.
locale/**/*.mo

# Environments
.env

# Chave privada Ed25519 do Node deste Nó Local (issue #123) -- nunca sob
# controlo de versões, gerada uma única vez na instalação.
node_private_key.pem
.venv
env/
venv/
ENV/

# Docker
docker-compose.override.yml

# TLS certificates/keys generated per installation (issue #142) -- never
# shared between installations, never committed. See
# scripts/generate_local_node_tls_cert.sh.
certs/

# Editors/OS
.vscode/
.idea/
.DS_Store

# Testing/coverage
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
