# Copy this file to `.env` and adjust the values for your environment. None
# of these defaults are acceptable in production.

# General
DJANGO_SETTINGS_MODULE=config.settings.base
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (local node / central node -- PostgreSQL)
POSTGRES_DB=fenixschool
POSTGRES_USER=fenixschool
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Local node -- Django-Q2
DJANGO_Q_WORKERS=2

# Central node -- Celery/Redis
REDIS_URL=redis://localhost:6379/0

# docker-compose.local-node.yml / docker-compose.central-node.yml (see
# docs/11-implantacao-e-operacoes.md §11.2/§11.3)
GUNICORN_WORKERS=3
HTTP_PORT=80
NGINX_SERVER_NAME=localhost
