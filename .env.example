# Copy this file to `.env` (gitignored -- never commit the real one) and fill
# in real values. `config/settings/base.py` reads every variable below via
# `django-environ` (see docs/09-seguranca-e-privacidade.md §9.7); nothing
# sensitive belongs in source code. For local development with no `.env` at
# all, every variable below falls back to a safe default (SQLite, DEBUG=True,
# etc.) -- see `config/settings/base.py`.
#
# The two production node stacks (docker-compose.local-node.yml /
# docker-compose.central-node.yml) each load their own `.env` via `env_file:`
# -- see those files' "Usage" comment for the `cp .env.example .env` step.
#
# NOTE: which settings module runs (base/local_node/central_node) is picked
# by the DJANGO_SETTINGS_MODULE environment variable itself, at invocation
# time -- e.g. `DJANGO_SETTINGS_MODULE=config.settings.local_node manage.py
# ...` or (as both compose files do) as a plain `environment:` entry. It is
# read before `.env` is, so it does not belong in this file.

# --- Core Django settings (all environments) --------------------------------

# A long, random, secret value. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# MUST be set to a real value in both node environments (local_node/central_node);
# the default in base.py is only good enough for local development.
DJANGO_SECRET_KEY=change-me-to-a-long-random-value

# Chave da cifra determinística de campo em repouso (issue #141, RNF-SEC-06)
# -- base64 de 64 bytes (AES-256-SIV). Gerar uma com:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(64)).decode())"
# MUST be set to a real value in both node environments; NEVER shared between
# institutions/nodes, and NEVER lost -- data encrypted with a lost key is
# permanently unrecoverable. The default in base.py is only good enough for
# local development.
FIELD_ENCRYPTION_KEY=change-me-to-a-long-random-base64-value

# true/false. Never true in a production node. Kept as `false` here even
# though local_node.py/central_node.py already default it to `false` when the
# variable is absent -- that default only helps if this line is deleted, not
# if it's copied over verbatim (`cp .env.example .env` is the documented
# setup step for both node stacks), and DEBUG=True in production leaks a full
# stack trace/settings dump to any visitor who triggers a 500, and defeats
# Nginx's cache-busting assumption that everything under /static/ is
# content-hashed (see docker/nginx/app.conf.template). Set to `true` only for
# `manage.py runserver` against `config.settings.base` directly.
DJANGO_DEBUG=false

# Comma-separated list of hostnames this Django instance is allowed to serve,
# e.g. escola-exemplo.fenixschool.ao,www.escola-exemplo.fenixschool.ao
DJANGO_ALLOWED_HOSTS=

# This node's own identity (a UUID), once registered with the Central node
# (docs/11-implantacao-e-operacoes.md §11.3 -- not built yet). Leave blank
# until then -- see apps/core/context.py's get_current_node_id().
NODE_ID=

# --- Security headers (all environments, RNF-SEG, issue #146) ----------------
# See config/settings/base.py's "Security headers" section.

# true/false. Only turn this on once this node's Nginx actually terminates
# TLS (docker-compose.tls.yml, issue #142) -- otherwise every request
# redirects into a loop and the browser drops the `Secure` session/CSRF
# cookies.
DJANGO_SECURE_SSL=false

# Seconds browsers should remember to only use HTTPS for this host, once
# DJANGO_SECURE_SSL is true. The one-year default is what enables HSTS
# preload eligibility.
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Logging (all environments, RNF-OBS-01) ----------------------------------
# See config/settings/base.py's "Logging" section. Structured (JSON) logs are
# always written to a locally rotated file, regardless of these being set.

# Directory the rotated JSON log file is written to.
DJANGO_LOG_DIR=logs

# Root logger level.
DJANGO_LOG_LEVEL=INFO

# Days of rotated log files to keep (one file per day, rotated at midnight).
DJANGO_LOG_RETENTION_DAYS=30

# --- Database (config.settings.local_node / config.settings.central_node) ---
# Ignored by config.settings.base (plain Django dev server), which always
# uses a local db.sqlite3 file instead -- these only matter for the two
# production node settings modules, which require PostgreSQL.

POSTGRES_DB=fenixschool
POSTGRES_USER=fenixschool
POSTGRES_PASSWORD=change-me
# Both compose files override this to "db" (the Postgres container's service
# name) themselves -- only relevant for the app running outside Docker.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Local node only (config.settings.local_node) ----------------------------

# Django-Q2 worker count (see Q_CLUSTER in local_node.py). No Redis: the
# broker lives in the same PostgreSQL database.
DJANGO_Q_WORKERS=2

# --- Central node only (config.settings.central_node) ------------------------

# Celery's broker/result backend. docker-compose.central-node.yml sets this
# itself to the `redis` service; only relevant when running outside Docker.
REDIS_URL=redis://localhost:6379/0

# Optional error reporting (RNF-OBS-03). Leave blank to disable Sentry
# entirely -- it is never required for the central node to start, and never
# used by the local node at all (offline-first: it must never depend on
# reaching a third-party service).
SENTRY_DSN=
SENTRY_ENVIRONMENT=central_node
# 0.0-1.0 fraction of requests to trace for performance monitoring, on top of
# error reporting. 0 (the default) disables it.
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Docker Compose only (docker-compose.local-node.yml / central-node.yml) --
# Read directly by the compose files, not by Django/`django-environ` itself.

# Gunicorn worker processes for the `web` service.
GUNICORN_WORKERS=3

# Server name Nginx serves (its `server_name` directive).
NGINX_SERVER_NAME=localhost

# Host port Nginx's container publishes to.
HTTP_PORT=80

# Host port Nginx's container publishes HTTPS to, only used when
# docker-compose.tls.yml is layered on top (issue #142) --
# see docs/11-implantacao-e-operacoes.md §11.3.1.
HTTPS_PORT=443
