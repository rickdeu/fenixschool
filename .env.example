# Copie este ficheiro para `.env` e ajuste os valores conforme o ambiente.
# Nenhum destes valores por omissão deve ser usado em produção.

# Geral
DJANGO_SETTINGS_MODULE=config.settings.base
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de dados (Nó Local / Nó Central — PostgreSQL)
POSTGRES_DB=fenixschool
POSTGRES_USER=fenixschool
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Nó Local — Django-Q2
DJANGO_Q_WORKERS=2

# Nó Central — Celery/Redis
REDIS_URL=redis://localhost:6379/0
